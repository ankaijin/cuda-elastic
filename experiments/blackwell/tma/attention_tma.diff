+// into shared memory with the TMA unit. The source and destination are
+// float4 arrays, so both are 16-byte aligned and bytes is a multiple of 16.
+__device__ __forceinline__ void bulk_copy(float4 *shared, const float4 *global,
+                                          unsigned bytes, unsigned long long *barrier) {
+  // Order this block's earlier generic-proxy accesses to the buffer (the
+  // compute warps' reads, ordered before this thread by the block barrier or
+  // the empty mbarrier) before the async-proxy write.
+  asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+  asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" ::"r"(
+                   shared_address(barrier)),
+               "r"(bytes)
+               : "memory");
+  asm volatile("cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes"
+               " [%0], [%1], %2, [%3];" ::"r"(shared_address(shared)),
+               "l"(global), "r"(bytes), "r"(shared_address(barrier))
+               : "memory");
+}

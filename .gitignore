# Compiled binaries
/multi_sensor_attention_graph

# Local agent worktrees and caches
.claude/worktrees/
.worktrees/
.superpowers/
__pycache__/
*.pyc

# Nsight profiling output. Plain nsys traces (.nsys-rep, .sqlite) are a few MB
# and are committed so results/cuda_performance.xlsx can link them. GPU-metrics
# traces (nsys --gpu-metrics-devices) export 120+ MB of .sqlite, over GitHub's
# 100 MB file limit, so commit only their .nsys-rep and a zstd copy:
#   zstd -19 -T0 nsys-metrics-<name>.sqlite    # -> .sqlite.zst; zstd -d to restore
*nsys-metrics*.sqlite

# Per-GPU mlperf-tiny build trees (upstream clone, Loom reference builds)
/*/mlperf-anomaly/build/
/*/mlperf-classification/build/
/*/pagerank/build/

# llama2c builds (make -C llama2c sota / baseline)
/*/llama2c/build/

# loom_private application builds
/*/loom_private/*/build/

# Feature experiment builds (experiments/blackwell)
/*/blackwell_experiments/*/build/
